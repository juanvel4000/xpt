#!/bin/sh
#ebs.formulae
ebsver=1

pkgname=hello
pkgver=0.1.0

pkgdesc="simple hello world program"
pkgmaintainer="you <you@example.com>"
pkgdeps=""

pkghomepage="https://dl.juanvel400.com/#hello"
pkglicense="BSD-3-Clause"

pkgsrc=https://dl.juanvel400.com/hello/hello-0.1.0.tar.xz
pkgchecksum=sha256:d36b4bba05ca8c097ebd30dbc69c77082be4421af46e4f1cfd5bf22143f27372
build() {
    make
}

check() {
    make check
}

package() {
    fakeroot make install DESTDIR="${pkgdir}"
}
