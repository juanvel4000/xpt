#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=hello
pkgver=0.1.5
pkgsrc=https://dl.juanvel400.com/hello/hello-$pkgver.tar.xz
pkgchecksum=sha256:4bb0fdcd07d8a7774ba71faecf86d7db64d7a8574ee395f51a86d629c39f77cc
pkgdesc="simple hello world program"
pkgmaintainer="you <you@example.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/hello"
pkgcheck=true

build() {
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" PREFIX=/usr
}
