#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=hello
pkgver=0.1.5
pkgsrc=https://dl.juanvel400.com/hello/hello-$pkgver.tar.xz
pkgchecksum=sha256:9393fd28a138fbbba4b9779e4c02607070c0f4ca678a42840f69f934390addf2
pkgdesc="simple hello world program"
pkgmaintainer="you <you@example.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/hello"
pkgcheck=true

build() {
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" PREFIX=/usr
}
