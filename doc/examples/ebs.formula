#!/bin/sh

#shellcheck disable=SC2034
#shellcheck disable=SC2154
#shellcheck disable=SC2086

#ebs.formulae
ebsver=1

pkgname=hello
pkgver=0.1.3
pkgsrc=https://dl.juanvel400.com/hello/hello-$pkgver.tar.xz
pkgchecksum=sha256:942c1b9ca27c3f4c619e23b92afa9948d1f962858e34fcaaaf82c57172edbdbe
pkgdesc="simple hello world program"
pkgmaintainer="you <you@example.com>"
pkglicense="BSD-3-Clause"
pkghomepage="https://sr.ht/~juanvel400/hello"
pkgcheck=true

build() {
    make
}

check() {
    make check
}

package() {
    "${1:-fakeroot}" make install DESTDIR="$pkgdir" PREFIX=/usr
}
